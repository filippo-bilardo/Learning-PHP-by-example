{
  "name": "PHP 8.3 Backend",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/php-course",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "xdebug.php-debug",
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-pack"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[php]": {
          "editor.defaultFormatter": "xdebug.php-pack"
        }
      }
    }
  },
  "forwardPorts": [8000, 3306],
  "portsAttributes": {
    "8000": {
      "label": "PHP development server",
      "onAutoForward": "openBrowser"
    },
    "3306": {
      "label": "MySQL"
    }
  },
  "postCreateCommand": "if [ -f composer.json ]; then composer install --no-interaction; fi",
  "postStartCommand": "nohup php -S 0.0.0.0:8000 -t \"${containerWorkspaceFolder}/www\" > /tmp/php-course-server.log 2>&1 < /dev/null &",
  "remoteUser": "vscode"
}
